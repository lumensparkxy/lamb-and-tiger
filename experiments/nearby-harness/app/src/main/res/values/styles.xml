<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="screen_padding">24dp</dimen>
    <style name="Theme.NearbyHarness" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#005A46</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="DiagnosticText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#202124</item>
    </style>
    <style name="DiagnosticHeading" parent="DiagnosticText">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
